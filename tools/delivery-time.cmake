# America/New_York wall time using the current US DST rules.
function(duck_delivery_stamp OUTPUT EPOCH)
  if(DEFINED ENV{SOURCE_DATE_EPOCH})
    set(SAVED_EPOCH "$ENV{SOURCE_DATE_EPOCH}")
  endif()
  set(ENV{SOURCE_DATE_EPOCH} "${EPOCH}")
  string(TIMESTAMP PARTS "%m;%d;%w;%H" UTC)
  list(GET PARTS 0 MONTH)
  list(GET PARTS 1 DAY)
  list(GET PARTS 2 WEEKDAY)
  list(GET PARTS 3 HOUR)
  foreach(PART MONTH DAY WEEKDAY HOUR)
    string(REGEX REPLACE "^0([0-9])$" "\\1" ${PART} "${${PART}}")
  endforeach()
  set(DST FALSE)
  if(MONTH GREATER 3 AND MONTH LESS 11)
    set(DST TRUE)
  elseif(MONTH EQUAL 3 OR MONTH EQUAL 11)
    math(EXPR FIRST_WEEKDAY "(${WEEKDAY} - ((${DAY} - 1) % 7) + 7) % 7")
    math(EXPR SUNDAY "1 + (7 - ${FIRST_WEEKDAY}) % 7")
    if(MONTH EQUAL 3)
      math(EXPR SUNDAY "${SUNDAY} + 7")
      if(DAY GREATER SUNDAY OR (DAY EQUAL SUNDAY AND HOUR GREATER_EQUAL 7))
        set(DST TRUE)
      endif()
    elseif(DAY LESS SUNDAY OR (DAY EQUAL SUNDAY AND HOUR LESS 6))
      set(DST TRUE)
    endif()
  endif()
  if(DST)
    math(EXPR LOCAL_EPOCH "${EPOCH} - 4 * 3600")
  else()
    math(EXPR LOCAL_EPOCH "${EPOCH} - 5 * 3600")
  endif()
  set(ENV{SOURCE_DATE_EPOCH} "${LOCAL_EPOCH}")
  string(TIMESTAMP STAMP "%Y-%m-%d_%H-%M-%S" UTC)
  if(DEFINED SAVED_EPOCH)
    set(ENV{SOURCE_DATE_EPOCH} "${SAVED_EPOCH}")
  else()
    unset(ENV{SOURCE_DATE_EPOCH})
  endif()
  set(${OUTPUT} "${STAMP}" PARENT_SCOPE)
endfunction()
