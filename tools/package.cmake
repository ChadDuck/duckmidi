# A local portable layout: the editor locates plugins/preferences/assets beside itself.
option(DUCKMIDI_PRODUCTION "Include the supplied SoundFont and first-launch sample" OFF)
install(TARGETS duckmidi RUNTIME DESTINATION .)
install(TARGETS m64export RUNTIME DESTINATION plugins LIBRARY DESTINATION plugins)
if(WIN32)
  install(FILES ${FLUID_DLLS} ${FFMPEG_DLLS} "$<TARGET_FILE:SDL3::SDL3>" DESTINATION .)
  if(EXISTS "${COMPILER_BIN}/libwinpthread-1.dll")
    install(FILES "${COMPILER_BIN}/libwinpthread-1.dll" DESTINATION .)
  endif()
endif()
install(FILES docs/user-guide.md docs/sm64-export.md docs/plugin-api.md DESTINATION docs)
install(FILES LICENSE DESTINATION licenses RENAME duckmidi-MIT.txt)
install(DIRECTORY vendor/licenses/ DESTINATION licenses FILES_MATCHING PATTERN "*.txt")

set(PACKAGE_DOCS "${CMAKE_CURRENT_BINARY_DIR}/docs")
file(MAKE_DIRECTORY "${PACKAGE_DOCS}")
configure_file(THIRD_PARTY_NOTICES.md "${PACKAGE_DOCS}/notices-source.md" COPYONLY)
file(READ "${PACKAGE_DOCS}/notices-source.md" NOTICES)
string(REPLACE "vendor/licenses/" "" NOTICES "${NOTICES}")
string(REPLACE "(LICENSE)" "(duckmidi-MIT.txt)" NOTICES "${NOTICES}")
file(WRITE "${PACKAGE_DOCS}/THIRD_PARTY_NOTICES.md" "${NOTICES}")
set(BUNDLE_HELP "Choose a SoundFont in Preferences or an external MIDI output.")
if(DUCKMIDI_PRODUCTION)
  if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/vendor/FluidR3.sf2")
    message(FATAL_ERROR "Production packaging requires vendor/FluidR3.sf2.")
  endif()
  file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/src/duck.h" SCHEMA_DEFINE REGEX "^#define DM_PROJECT_SCHEMA [0-9]+$")
  string(REGEX REPLACE ".*DM_PROJECT_SCHEMA ([0-9]+)$" "\\1" SCHEMA "${SCHEMA_DEFINE}")
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/funky-beat.duck" SAMPLE_HEADER LIMIT 12 HEX)
  string(LENGTH "${SAMPLE_HEADER}" HEADER_LENGTH)
  if(NOT HEADER_LENGTH EQUAL 24)
    message(FATAL_ERROR "The supplied sample project has an incomplete header.")
  endif()
  foreach(BYTE RANGE 0 3)
    math(EXPR OFFSET "16 + ${BYTE} * 2")
    string(SUBSTRING "${SAMPLE_HEADER}" ${OFFSET} 2 VALUE)
    if(BYTE EQUAL 0)
      set(SAMPLE_SCHEMA 0)
    endif()
    math(EXPR SAMPLE_SCHEMA "${SAMPLE_SCHEMA} | (0x${VALUE} << (${BYTE} * 8))")
  endforeach()
  if(NOT SAMPLE_SCHEMA EQUAL SCHEMA)
    message(FATAL_ERROR "Update assets/funky-beat.duck to the current project schema before production packaging.")
  endif()
  install(FILES vendor/FluidR3.sf2 DESTINATION assets)
  install(FILES assets/funky-beat.duck DESTINATION projects)
  set(BUNDLE_HELP "Includes a default SoundFont and projects/funky-beat.duck, opened on first launch.")
endif()
file(WRITE "${PACKAGE_DOCS}/README.txt"
  "duckmidi ${PROJECT_VERSION}\n\nKeep the runtime libraries and plugins/ beside the executable. ${BUNDLE_HELP}\n\nSee user-guide.md, sm64-export.md and plugin-api.md in this docs/ folder.\n\nduckmidi uses the MIT license; see ../licenses/duckmidi-MIT.txt and ../licenses/THIRD_PARTY_NOTICES.md.\n")
install(FILES "${PACKAGE_DOCS}/README.txt" DESTINATION docs)
install(FILES "${PACKAGE_DOCS}/THIRD_PARTY_NOTICES.md" DESTINATION licenses)
add_custom_target(deliver
  COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}"
    "-DBUILD_DIR=${CMAKE_BINARY_DIR}" "-DVERSION=${PROJECT_VERSION}" "-DCONFIG=$<CONFIG>"
    -P "${CMAKE_CURRENT_SOURCE_DIR}/tools/deliver.cmake"
  DEPENDS duckmidi
  USES_TERMINAL VERBATIM)
